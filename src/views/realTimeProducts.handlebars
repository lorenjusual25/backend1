<h1>formulario para crear un producto en tiempo real: </h1> <br>
<form id="productForm">
    <input type="text" name="title" placeholder="title" required>
    <input type="text" name="description" placeholder="description" required>
    <input type="number" name="price" placeholder="price" required>
    <input type="number" name="stock" placeholder="stock" required>
    <select name="status" required>
        <option value="true">disponible</option>
        <option value="false">no disponible</option>
    </select>
    <input type="text" name="thumbnail" placeholder="ingrese 'img.png'" required>
    <input type="text" name="category" placeholder="category" required>
    <button type="submit">Crear producto</button>
</form>
<h2>Productos:</h2> <br>
<div id="productsContainer">
    {{#each pagination.docs}}
        <div data-id="{{this._id}}">
            <h2>{{this.title}}</h2>
            <p>{{this.description}}</p>
            <p>Precio: ${{this.price}}</p>
            <p>Stock: {{this.stock}}</p>
            <button class="deleteBtn" data-id="{{this._id}}">BORRAR</button>
            <button class="detailsBtn" data-id="{{this._id}}">DETALLES</button>
        </div>
    {{/each}}
</div>
<br>
{{#if pagination.hasPrevPage}}
    <a href="/realtimeproducts?page={{pagination.prevPage}}"><</a>
{{/if}}
<a href="/realtimeproducts?page={{pagination.page}}">{{pagination.page}}</a>
{{#if pagination.hasNextPage}}
    <a href="/realtimeproducts?page={{pagination.nextPage}}">></a>
{{/if}}
<script src="/socket.io/socket.io.js"></script>
<script src="/js/realtimeproducts.js"></script>